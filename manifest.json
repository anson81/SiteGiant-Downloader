{
  "manifest_version": 3,
  "name": "SiteGiant Downloader",
  "version": "1.10.0",
  "description": "Download SiteGiant orders and stock/cost reports, and push them into ProfitLens",
  "minimum_chrome_version": "111",
  "permissions": [
    "downloads",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://sitegiant.co/*",
    "https://cdn1.sgliteasset.com/*",
    "https://profitlens.my/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://raw.githubusercontent.com/*"
  ],
  "options_page": "options/options.html",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://sitegiant.co/*"],
      "js": ["content/sitegiant.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": ["https://profitlens.my/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content/profitlens.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ]
}
